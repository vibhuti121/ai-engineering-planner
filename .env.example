# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Production path. When set, the app calls the Anthropic API directly.
ANTHROPIC_API_KEY=

# auto (default) | api | cli | demo
#   auto → api if ANTHROPIC_API_KEY is set, else cli if the `claude` binary is on PATH, else demo
#   cli  → development path: shells out to the Claude Code CLI (uses your subscription, no API key)
#   demo → replays fixtures/demo-plan.json, so the app runs with no credentials at all
PLANNER_PROVIDER=auto

# The last-resort default, used when models.json says nothing.
PLANNER_MODEL=claude-sonnet-5

# ── Which model runs which stage: edit `models.json`, not this file ───────────────────────────────
#
# models.json is the one place to change it, and it is tracked in git — it holds no secret, and
# which model plans the task graph is a property of the project, not of one laptop:
#
#     { "default": "claude-sonnet-5", "read": "", "graph": "claude-opus-5", "verify": "claude-opus-5" }
#
# A blank stage inherits "default". Both the `api` and `cli` providers honour the split, because
# each stage is its own call either way — so a subscription with no API key gets it too.
#
# The stages are not equally hard, and that is the whole argument for splitting them. Reading a PRD
# into a requirement list is extraction: mechanical, cheap, and a stronger model buys nothing.
# Building the task graph and reviewing the finished plan are both reasoning — one decides whether
# the plan is any good, the other says what would make it better. So the shipped split is a cheap
# reader under a stronger graph and review stage.
#
# Each stage's model is part of that stage's cache key, so changing one re-runs that stage and
# everything downstream of it, and leaves the stages above it loading from artifacts/.
#
# The variables below override models.json for a single stage. They exist for CI and tests, which
# need to pin a stage without editing a tracked file — for ordinary use, edit models.json.
PLANNER_MODEL_READ=
PLANNER_MODEL_GRAPH=
PLANNER_MODEL_VERIFY=

# Seconds to wait for one planning call before giving up. A 20-task plan is ~20k output tokens,
# which takes roughly 3 minutes; the default leaves headroom for a longer PRD.
PLANNER_TIMEOUT=600

# Bounded LRU capacity for the in-memory plan store.
PLAN_CACHE_SIZE=100

# Where intermediate stage outputs are written, one folder per PRD. Defaults to <repo>/artifacts,
# which is local working state — it is the L2 cache, not a deliverable, and a fresh clone starts
# empty and cold. Point it somewhere under /tmp to keep the repo clean (ASSUMPTIONS.md #23).
ARTIFACTS_DIR=
